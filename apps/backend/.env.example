# ═══════════════════════════════════════════════════
# Althea System - Backend Environment
# ═══════════════════════════════════════════════════
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais committer le .env réel (contient des secrets).

# ── Serveur ──────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── JWT ──────────────────────────────────────────────
# Générer une valeur aléatoire forte en production :
# openssl rand -hex 64
JWT_SECRET=althea-jwt-secret-change-in-production

# ── PostgreSQL (Prisma) ───────────────────────────────
# Port 5433 : défaut Docker Compose du projet
DATABASE_URL=postgresql://althea_user:althea_password@localhost:5433/althea?schema=public

# ── MongoDB (chatbot) ────────────────────────────────
MONGODB_URI=mongodb://althea_user:althea_password@localhost:27018/althea?authSource=admin

# ── Stripe ───────────────────────────────────────────
# Clé secrète : Dashboard Stripe > Développeurs > Clés API
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Secret webhook : Dashboard Stripe > Développeurs > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── Meilisearch ──────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=althea-meili-master-key

# ── Email ────────────────────────────────────────────
# Fournisseur actif : "resend" ou "sendgrid"
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@althea-system.com

# Resend (https://resend.com — recommandé)
RESEND_API_KEY=re_your-resend-key

# SendGrid (optionnel — fallback si EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.your-sendgrid-key

# ── Traduction automatique (MyMemory) ─────────────────
# Sans email : 1 000 mots/jour gratuits
# Avec email valide : 10 000 mots/jour (pas d'inscription requise)
MYMEMORY_EMAIL=your-email@example.com
