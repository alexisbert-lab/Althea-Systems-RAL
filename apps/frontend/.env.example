# ═══════════════════════════════════════════════════
# Althea System - Frontend Environment
# ═══════════════════════════════════════════════════
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais committer le .env réel (contient des secrets).

# ── API Backend ──────────────────────────────────────
# URL de base sans /api (le code l'ajoute automatiquement)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Stripe (côté client) ─────────────────────────────
# Clé publique : Dashboard Stripe > Développeurs > Clés API
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ── Chatbot IA (optionnel) ───────────────────────────
# Sans clé : le chatbot fonctionne en mode local (réponses prédéfinies)
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
# Anthropic Claude (alternatif à OpenAI)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
